<!-- Use this file to deploy some handlers/chains and services      -->
<!-- Two ways to do this:                                           -->
<!--   java org.apache.axis.client.AdminClient deploy.wsdd          -->
<!--      after the axis server is running                          -->
<!-- or                                                             -->
<!--   java org.apache.axis.utils.Admin client|server deploy.wsdd   -->
<!--      from the same directory that the Axis engine runs         -->

<wsdd:deployment xmlns:XMLSchema="http://www.w3.org/2001/XMLSchema"
    xmlns:example.com="http://example.com" xmlns:java="http://xml.apache.org/axis/wsdd/providers/java"
    xmlns:wsdd="http://xml.apache.org/axis/wsdd/">
  <wsdd:service name="MNPFrame" provider="java:RPC" use="literal" style="wrapped">
    <wsdd:parameter name="wsdlTargetNamespace" value="http://example.com"/>
    <wsdd:parameter name="wsdlServiceElement" value="MNPFrameService"/>
    <wsdd:parameter name="schemaQualified" value="http://example.com"/>
    <wsdd:parameter name="wsdlServicePort" value="MNPFrame"/>
    <wsdd:parameter name="className" value="com.example.MNPFrameSoapBindingImpl"/>
    <wsdd:parameter name="wsdlPortType" value="MNPFrame"/>
    <wsdd:parameter name="typeMappingVersion" value="1.2"/>
    <wsdd:parameter name="allowedMethods" value="getVersion getNPOOrNVPOrNVPA setVersion"/>
    <wsdd:typeMapping qname="example.com:>getVersion" type="java:com.example.GetVersion"
        encodingStyle="" serializer="org.apache.axis.encoding.ser.BeanSerializerFactory"
        deserializer="org.apache.axis.encoding.ser.BeanDeserializerFactory"/>
    <wsdd:typeMapping qname="example.com:>setVersionResponse" type="java:com.example.SetVersionResponse"
        encodingStyle="" serializer="org.apache.axis.encoding.ser.BeanSerializerFactory"
        deserializer="org.apache.axis.encoding.ser.BeanDeserializerFactory"/>
    <wsdd:typeMapping qname="example.com:>setVersion" type="java:com.example.SetVersion"
        encodingStyle="" serializer="org.apache.axis.encoding.ser.BeanSerializerFactory"
        deserializer="org.apache.axis.encoding.ser.BeanDeserializerFactory"/>
    <wsdd:typeMapping qname="example.com:>getNPOOrNVPOrNVPA" type="java:com.example.GetNPOOrNVPOrNVPA"
        encodingStyle="" serializer="org.apache.axis.encoding.ser.BeanSerializerFactory"
        deserializer="org.apache.axis.encoding.ser.BeanDeserializerFactory"/>
    <wsdd:typeMapping qname="example.com:>getVersionResponse" type="java:com.example.GetVersionResponse"
        encodingStyle="" serializer="org.apache.axis.encoding.ser.BeanSerializerFactory"
        deserializer="org.apache.axis.encoding.ser.BeanDeserializerFactory"/>
    <wsdd:typeMapping qname="example.com:>getNPOOrNVPOrNVPAResponse" type="java:com.example.GetNPOOrNVPOrNVPAResponse"
        encodingStyle="" serializer="org.apache.axis.encoding.ser.BeanSerializerFactory"
        deserializer="org.apache.axis.encoding.ser.BeanDeserializerFactory"/>
    <wsdd:arrayMapping qname="example.com:ArrayOf_xsd_anyType" type="java:java.lang.Object[]"
        encodingStyle="" innerType="XMLSchema:anyType"/>
    <wsdd:operation name="setVersion" qname="example.com:setVersion" soapAction="">
      <wsdd:parameter qname="example.com:value" type="XMLSchema:string"/>
    </wsdd:operation>
    <wsdd:operation name="getNPOOrNVPOrNVPA" qname="example.com:getNPOOrNVPOrNVPA"
        returnQName="example.com:getNPOOrNVPOrNVPAReturn" returnType="example.com:ArrayOf_xsd_anyType"
        returnItemQName="example.com:item" soapAction=""/>
    <wsdd:operation name="getVersion" qname="example.com:getVersion" returnQName="example.com:getVersionReturn"
        returnType="XMLSchema:string" soapAction=""/>
  </wsdd:service>
</wsdd:deployment>
