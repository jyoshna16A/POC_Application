<?xml version="1.0"?>
<project name="jboss wsconsume" basedir=".">
   <!-- Load the JBossWS Ant tasks -->
   <property name="jboss.home" location="C:\Users\ADMIN\Downloads\jboss-5.1.0.GA\jboss-5.1.0.GA"/>
   <path id="jboss.classpath">
      <fileset dir="${jboss.home}/lib">
         <include name="jbossws-spi.jar"/>
         <include name="jbossws-native-core.jar"/>
         <include name="streamBuffer.jar"/>
         <include name="stax-ex.jar"/>
      </fileset>
      <pathelement location="C:\Users\ADMIN\Downloads\jar_files\ant.jar"/>
      <pathelement location="C:\Users\ADMIN\Downloads\jar_files\ant-launcher.jar"/>
   </path>
   <target name="generateClient" depends="clean">
      <mkdir dir="output"/>
      <mkdir dir="gen-src"/>
      <java classname="org.jboss.ws.tools.WSConsume" fork="true" failonerror="true">
         <arg value="-k"/>
         <arg value="-s"/>
         <arg value="output"/>
         <arg value="gen-src"/>
         <arg value="C:\Users\ADMIN\Downloads\mnpservice.wsdl"/>
         <classpath>
            <path refid="jboss.classpath"/>
         </classpath>
      </java>
   </target>
   <target name="clean">
      <!-- Clean generated directories -->
      <echo>Cleaning output and generated source directories...</echo>
      <delete dir="output"/>
      <delete dir="gen-src"/>
   </target>
</project>
