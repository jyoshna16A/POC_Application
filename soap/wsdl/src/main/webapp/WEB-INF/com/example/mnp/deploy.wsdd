<!-- Use this file to deploy some handlers/chains and services      -->
<!-- Two ways to do this:                                           -->
<!--   java org.apache.axis.client.AdminClient deploy.wsdd          -->
<!--      after the axis server is running                          -->
<!-- or                                                             -->
<!--   java org.apache.axis.utils.Admin client|server deploy.wsdd   -->
<!--      from the same directory that the Axis engine runs         -->

<wsdd:deployment xmlns:java="http://xml.apache.org/axis/wsdd/providers/java"
    xmlns:mnp="http://example.com/mnp" xmlns:wsdd="http://xml.apache.org/axis/wsdd/">
  <wsdd:service name="MnpServicePort" provider="java:RPC" use="literal" style="document">
    <wsdd:parameter name="wsdlTargetNamespace" value="http://example.com/mnp"/>
    <wsdd:parameter name="wsdlServiceElement" value="MnpService"/>
    <wsdd:parameter name="schemaUnqualified" value="http://example.com/mnp"/>
    <wsdd:parameter name="wsdlServicePort" value="MnpServicePort"/>
    <wsdd:parameter name="className" value="com.example.mnp.MnpServiceBindingSkeleton"/>
    <wsdd:parameter name="wsdlPortType" value="MnpServicePortType"/>
    <wsdd:parameter name="typeMappingVersion" value="1.2"/>
    <wsdd:parameter name="allowedMethods" value="*"/>
    <wsdd:typeMapping qname="mnp:>getMnpServiceRequest" type="java:com.example.mnp.GetMnpServiceRequest"
        encodingStyle="" serializer="org.apache.axis.encoding.ser.BeanSerializerFactory"
        deserializer="org.apache.axis.encoding.ser.BeanDeserializerFactory"/>
    <wsdd:typeMapping qname="mnp:>getMnpServiceResponse" type="java:com.example.mnp.GetMnpServiceResponse"
        encodingStyle="" serializer="org.apache.axis.encoding.ser.BeanSerializerFactory"
        deserializer="org.apache.axis.encoding.ser.BeanDeserializerFactory"/>
  </wsdd:service>
</wsdd:deployment>
